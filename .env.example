# Meeting Assistant - local configuration
# Template: copy to .env and fill in real values. Safe to commit (no secrets).
# Hostnames are docker compose service names, since everything runs in Docker.

# --- App ---
API_PORT=8080

# --- Providers ---
# Everything works offline with no API key
# SUMMARY_PROVIDER: fake | claude
SUMMARY_PROVIDER=fake
# TRANSCRIPTION_PROVIDER: whisper | fake
TRANSCRIPTION_PROVIDER=whisper

# --- Claude API (anthropic-sdk-go) ---
# Needed only when SUMMARY_PROVIDER=claude; an empty key falls back to fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low

# --- Postgres ---
POSTGRES_USER=meeting
POSTGRES_PASSWORD=meeting
POSTGRES_DB=meeting_assistant
# App and River workers go through PgBouncer
DATABASE_URL=postgres://meeting:meeting@pgbouncer:6432/meeting_assistant?sslmode=disable
# Direct connection: migrations only (DDL, advisory locks, session features)
DATABASE_DIRECT_URL=postgres://meeting:meeting@postgres:5432/meeting_assistant?sslmode=disable

# --- PgBouncer ---
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_MAX_CLIENT_CONN=500
# PgBouncer 1.21+: lets pgx keep its prepared statement cache in transaction mode
PGBOUNCER_MAX_PREPARED_STATEMENTS=200

# --- River ---
# LISTEN/NOTIFY doesn't pass through PgBouncer transaction pooling, so River polls for new jobs
RIVER_POLL_ONLY=true
# Workers per queue
RIVER_TRANSCRIBE_WORKERS=2
RIVER_SUMMARIZE_WORKERS=4
RIVER_INDEX_WORKERS=4

# --- OpenSearch ---
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX_ALIAS=meetings
OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m"

# --- Object storage (RustFS, S3-compatible) ---
S3_ENDPOINT=http://object-store:9000
S3_REGION=us-east-1
S3_BUCKET=recordings
S3_ACCESS_KEY=local-access-key
S3_SECRET_KEY=local-secret-key

# --- Local Whisper (default speech-to-text) ---
WHISPER_URL=http://whisper:9000
# tiny | base | small | medium: bigger is more accurate and slower on CPU
WHISPER_MODEL=small
WHISPER_TIMEOUT_SECONDS=1800

# --- Uploads ---
MAX_UPLOAD_MB=200
